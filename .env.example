LOG_LEVEL=DEBUG
LOG_DIR=logs
LOG_RETENTION_DAYS=14

SYSTEM_SKILLS_ENABLED=False
SANDBOX_ENABLED=True

POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_ASYNCPG=asyncpg

REDIS_HOST=localhost
REDIS_PORT=6381

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=nodya_memory

CONSOLIDATION_SCAN_MINUTES=30
CONSOLIDATION_IDLE_MINUTES=180
CONSOLIDATION_MIN_MESSAGES=8
FACTS_IN_PROMPT_LIMIT=20
VECTOR_SEARCH_LIMIT=5
FACTS_MIN_CONFIDENCE=0.4

MEDIA_IMAGE_MAX_BYTES=5242880
MEDIA_DESCRIPTION_MAX_CHARS=600
MEDIA_MAX_PER_BATCH=10

# 70% answer now, 20% generate now and deliver after a delay, 10% skip.
PROACTIVE_ENABLED=True
PROACTIVE_NOW_PERCENT=70
PROACTIVE_DELAY_PERCENT=20
PROACTIVE_SKIP_PERCENT=10
PROACTIVE_DELAY_MIN_SECONDS=300
PROACTIVE_DELAY_MAX_SECONDS=7200

FEED_SCAN_MINUTES=60
FEED_MAX_ITEMS_PER_SOURCE=5
FEED_NOTIFY_SCORE=8.0
FEED_STORE_SCORE=5.0
FEED_SEEN_TTL_DAYS=7
FEED_REQUEST_TIMEOUT=15

# Source management: hard caps against quota burn and notification spam.
FEED_MAX_ACTIVE_SOURCES=20
FEED_MAX_ITEMS_PER_RUN=15
FEED_NOTIFY_DAILY_LIMIT=10
FEED_AUTOCAPTURE_ENABLED=True
FEED_AUTOCAPTURE_DAILY_LIMIT=3
FEED_REACTION_ENABLED=True

# Weekly interest-based discovery (Tavily -> Brave -> DuckDuckGo).
FEED_DISCOVERY_ENABLED=True
FEED_DISCOVERY_INTERVAL_HOURS=168
FEED_DISCOVERY_QUERIES=3
FEED_DISCOVERY_MAX_RESULTS=5
FEED_DISCOVERY_MAX_CANDIDATES=12
FEED_DISCOVERY_MAX_SOURCES=2
FEED_DISCOVERY_MIN_SCORE=8.0
SEARCH_TAVILY_API_KEY=
SEARCH_BRAVE_API_KEY=
SEARCH_REQUEST_TIMEOUT=10

CONFIDENCE_DECAY_AFTER_DAYS=7
CONFIDENCE_DECAY_FACTOR=0.95
CONFIDENCE_DECAY_MIN_CONFIDENCE=0.1

GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Self-hosters must set their own Cloudflare Worker URL.
# No default — traffic must not silently go to author's worker.
GEMINI_CLOUDFLARE_URL=https://geminifix.example.workers.dev/
GEMINI_ENABLED=False
LLM_HISTORY_LIMIT=20
# LLM_PROVIDER_CHAINS is JSON in .env; default in code is 3-level priority:
# dialogue: gemini_cloudflare (flash-lite) -> openrouter nemotron -> claude/haiku
# cs: gemini_cloudflare (3.6-flash) -> nemotron -> haiku
# bp: openrouter gemma -> nemotron -> qwen coder
# vs: gemini_cloudflare embedding

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=change-me-long-random-string

TUNNEL_TIMEOUT=30

DEBOUNCE_SECONDS=5
SCHEDULED_POLL_SECONDS=30
MAX_SCHEDULED_RETRIES=5
APP_PORT=8014

# Admin panel (nodya_admin container).
# Grafana/Loki/Prometheus credentials live in observability/grafana.env.
# Do NOT add their variables here: SettingsSchema uses extra="forbid".
# Local http runs need ADMIN_COOKIE_SECURE=False,
# ADMIN_PUBLIC_ORIGIN=http://localhost:8016 and a trimmed ADMIN_ALLOWED_HOSTS.
DOCKER_PROXY_URL=http://docker-proxy:2375
ADMIN_SESSION_TTL_MINUTES=720
ADMIN_COOKIE_SECURE=True
ADMIN_COMPOSE_PROJECT=nodya
ADMIN_LOGS_DIR=logs
ADMIN_PUBLIC_ORIGIN=https://admin.nodya.shayden.ru
ADMIN_ALLOWED_HOSTS=admin.nodya.shayden.ru,localhost,127.0.0.1,testserver,nodya_admin
GRAFANA_PUBLIC_URL=https://grafana.nodya.shayden.ru

# Observability
ERROR_EVENTS_ENABLED=True
ERROR_EVENTS_TTL_DAYS=30
METRICS_ENABLED=True
METRICS_PORT=8015

