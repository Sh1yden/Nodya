LOG_LEVEL=DEBUG

SYSTEM_SKILLS_ENABLED=False
SANDBOX_ENABLED=True

POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_ASYNCPG=asyncpg

REDIS_HOST=localhost
REDIS_PORT=6381

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=nodya_memory

CONSOLIDATION_SCAN_MINUTES=30
CONSOLIDATION_IDLE_MINUTES=180
CONSOLIDATION_MIN_MESSAGES=8
FACTS_IN_PROMPT_LIMIT=20
VECTOR_SEARCH_LIMIT=5
FACTS_MIN_CONFIDENCE=0.4

GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Self-hosters must set their own Cloudflare Worker URL.
# No default — traffic must not silently go to author's worker.
GEMINI_CLOUDFLARE_URL=https://geminifix.example.workers.dev/
GEMINI_ENABLED=False
LLM_HISTORY_LIMIT=20
# LLM_PROVIDER_CHAINS is JSON in .env; default in code is 3-level priority:
# dialogue: gemini_cloudflare (flash-lite) -> openrouter nemotron -> claude/haiku
# cs: gemini_cloudflare (3.6-flash) -> nemotron -> haiku
# bp: openrouter gemma -> nemotron -> qwen coder
# vs: gemini_cloudflare embedding

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=change-me-long-random-string

TUNNEL_TIMEOUT=30

DEBOUNCE_SECONDS=5
SCHEDULED_POLL_SECONDS=30
MAX_SCHEDULED_RETRIES=5
APP_PORT=8014

