# Copy to observability/grafana.env (gitignored) and set a real password.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me

GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false
GF_SECURITY_COOKIE_SECURE=true
GF_SERVER_ROOT_URL=https://grafana.nodya.shayden.ru
# Host port 3000 belongs to the portfolio; compose overrides this too.
GF_SERVER_HTTP_PORT=3002

GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES=false
GF_ANALYTICS_FEEDBACK_LINKS_ENABLED=false
