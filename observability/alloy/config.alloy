logging {
  level = "warn"
}

// Container logs: everything in the compose project except nodya_heart,
// whose logs are shipped from JSONL files below (no duplicates in Loki).
discovery.docker "nodya" {
  host = "tcp://docker-proxy:2375"

  filter {
    name   = "label"
    values = ["com.docker.compose.project=nodya"]
  }
}

discovery.relabel "nodya_docker_logs" {
  targets = discovery.docker.nodya.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/nodya_heart"
    action        = "drop"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }

  // Dashboards filter docker logs by job="docker"; JSONL app logs use job="app".
  rule {
    target_label = "job"
    replacement  = "docker"
  }
}

loki.source.docker "nodya" {
  host             = "tcp://docker-proxy:2375"
  targets          = discovery.relabel.nodya_docker_logs.output
  refresh_interval = "5s"
  forward_to       = [loki.write.default.receiver]
}

// Application JSONL logs written by nodya_heart into the shared ./logs dir.
local.file_match "nodya_app_logs" {
  path_targets = [{
    __path__ = "/var/log/nodya/*.jsonl",
    job      = "app",
    service  = "nodya_heart",
  }]
}

loki.source.file "nodya_app_logs" {
  targets    = local.file_match.nodya_app_logs.targets
  forward_to = [loki.process.nodya_app_logs.receiver]
}

loki.process "nodya_app_logs" {
  // JSONL has only HH:MM:SS timestamps, so Loki keeps ingestion time.
  stage.json {
    expressions = {
      level  = "level",
      module = "full_module",
    }
  }

  stage.labels {
    values = {
      level  = "",
      module = "",
    }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
