{
  "uid": "nodya-logs",
  "title": "Nodya Logs",
  "tags": ["nodya", "logs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {"from": "now-3h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Сервис",
        "type": "query",
        "datasource": {"type": "loki", "uid": "loki"},
        "query": "label_values(service)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": {"text": "All", "value": "$__all"}
      },
      {
        "name": "level",
        "label": "Уровень",
        "type": "query",
        "datasource": {"type": "loki", "uid": "loki"},
        "query": "label_values(level)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": {"text": "All", "value": "$__all"}
      },
      {
        "name": "module",
        "label": "Модуль",
        "type": "query",
        "datasource": {"type": "loki", "uid": "loki"},
        "query": "label_values(module)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": {"text": "All", "value": "$__all"}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "Контейнерные логи (infra, admin)",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"docker\", service=~\"$service\"}",
          "queryType": "range",
          "datasource": {"type": "loki", "uid": "loki"}
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Логи приложения (JSONL)",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 9},
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"app\", level=~\"$level\", module=~\"$module\"}",
          "queryType": "range",
          "datasource": {"type": "loki", "uid": "loki"}
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Объём логов приложения по уровням",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 18},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (level) (count_over_time({job=\"app\", level=~\"$level\", module=~\"$module\"}[$__interval]))",
          "queryType": "range",
          "datasource": {"type": "loki", "uid": "loki"}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "linear",
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "short",
          "color": {"mode": "palette-classic"}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    }
  ]
}
