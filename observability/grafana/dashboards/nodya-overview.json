      "title": "Очереди: ready",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 21},
      "targets": [
        {
          "refId": "A",
          "expr": "rabbitmq_queue_messages_ready{queue=~\"incoming_messages|outgoing_messages|typing_events|nodya_dlq\"}",
