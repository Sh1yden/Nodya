      "title": "Очереди: consumers",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 29},
      "targets": [
        {
          "refId": "A",
          "expr": "rabbitmq_queue_consumers{queue=~\"incoming_messages|outgoing_messages|typing_events|nodya_dlq\"}",
