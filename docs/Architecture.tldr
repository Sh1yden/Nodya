:0.4613948574281255,"y":0.4454318596113005},"snap":"none","terminal":"end"},"typeName":"binding"},{"meta":{},"id":"binding:72FlVjfxiiQvhVjxIqehW","type":"arrow","fromId":"shape:ox77qXISEutDGw_8w0qiY","toId":"shape:xNw0sbYP6SBa_lQ7IH3_4","props":{"isPrecise":true,"isExact":false,"normalizedAnchor":{"x":0.5,"y":0.5},"snap":"center","terminal":"start"},"typeName":"binding"},{"x":-552.5694373586407,"y":570.2365938726989,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:I1dX13v7IdwBqPSui5nCP","type":"text","props":{"color":"black","size":"m","w":2139.887451171875,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"heading","attrs":{"dir":"auto","level":1},"content":[{"type":"text","text":"Слои памяти"}]},{"type":"heading","attrs":{"dir":"auto","level":2},"content":[{"type":"text","text":"Слой 1: Краткосрочная память и Стейт (Redis)"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Redis здесь выступает как гиппокамп — он держит то, что происходит в данную секунду, и быстро это забывает."}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Что здесь храним:"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Стейт агента (State):"},{"type":"text","text":" Текущее состояние Ноди (свободна, читает RSS, генерирует ответ, спит)."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Скользящее окно диалога (Sliding Window Context):"},{"type":"text","text":" Последние N сообщений вашей текущей беседы."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Рейт-лимиты и буферы:"},{"type":"text","text":" Тот самый паттерн Debounce, который мы обсуждали, чтобы склеивать твои сообщения."}]}]}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Как правильно организовать (Паттерны):"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Ограничение длины списка:"},{"type":"text","text":" Хранить весь диалог в Redis нельзя — окно контекста LLM лопнет. Используй паттерн "},{"type":"text","marks":[{"type":"italic"}],"text":"Capped List"},{"type":"text","text":" (ограниченный список). Как только сообщений становится больше, например, 20-ти, самое старое выталкивается."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"TTL (Time To Live):"},{"type":"text","text":" У сессии диалога должно быть время жизни. Если ты не писал Ноде 3 часа, ключ с контекстом диалога должен автоматически \"протухнуть\" (удалиться). Для Ноди это сигнал: текущая беседа завершена, пора переходить в режим \"Сна\" и сжимать факты."}]}]}]},{"type":"heading","attrs":{"dir":"auto","level":2},"content":[{"type":"text","text":"Слой 2: Долгосрочная база фактов (PostgreSQL)"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Это жесткий диск Ноди. Сюда попадает только то, что прошло аналитическую фильтрацию во время её \"сна\"."}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Что здесь храним:"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Профиль пользователя (User Identity):"},{"type":"text","text":" Твои настройки, чат-айди."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Структурированные факты:"},{"type":"text","text":" Выжимки из диалогов, разделенные по категориям (проекты, технологии, хобби, люди)."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Журнал событий (Audit Log):"},{"type":"text","text":" Системные логи того, какие инструменты (Tools) Нодя вызывала в системе и с каким результатом."}]}]}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Как правильно организовать (Паттерны):"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Модель EAV (Entity-Attribute-Value) или JSONB:"},{"type":"text","text":" Поскольку ты не можешь заранее знать, какие факты Нодя о тебе узнает, создавать под всё отдельные колонки бессмысленно. Лучше сделать таблицу "},{"type":"text","marks":[{"type":"code"}],"text":"memory_facts"},{"type":"text","text":" с колонками: "},{"type":"text","marks":[{"type":"code"}],"text":"category"},{"type":"text","text":" (например, \"preference\", \"project_status\"), "},{"type":"text","marks":[{"type":"code"}],"text":"key"},{"type":"text","text":" и "},{"type":"text","marks":[{"type":"code"}],"text":"value"},{"type":"text","text":" (в формате JSONB). Это даст жесткую реляционную структуру, но гибкость внутри самого факта."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Уровень достоверности (Confidence Score):"},{"type":"text","text":" Хорошая практика — добавлять к каждому факту вес (от 0.1 до 1.0). Если Нодя один раз услышала от тебя про какую-то технологию — вес низкий. Если ты обсуждаешь её неделю — вес повышается. Факты с низким весом со временем можно удалять (процесс \"забывания\")."}]}]}]},{"type":"heading","attrs":{"dir":"auto","level":2},"content":[{"type":"text","text":"Слой 3: Семантическая память (Vector Storage)"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Это ассоциативная память. Если ты спросишь: "},{"type":"text","marks":[{"type":"italic"}],"text":"\"А помнишь, мы месяц назад обсуждали какую-то библиотеку для графиков?\""},{"type":"text","text":", ни Redis, ни обычный SQL-поиск по таблице фактов тебе не помогут, потому что ты не помнишь точных слов."}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Что здесь храним:"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Эмбеддинги (Embeddings):"},{"type":"text","text":" Векторные представления больших кусков текста (старых диалогов, прочитанных статей из Telegram-каналов)."}]}]}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Как правильно организовать (Паттерны):"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Архитектура RAG (Retrieval-Augmented Generation):"},{"type":"text","text":" Когда ты задаешь вопрос, Нодя сначала переводит его в вектор, ищет ближайшие по смыслу векторы в базе, достает текст и подкидывает его в системный промпт со словами: "},{"type":"text","marks":[{"type":"italic"}],"text":"\"Вот что мы обсуждали на эту тему раньше\""},{"type":"text","text":"."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Выбор инструмента:"},{"type":"text","text":" Так как мы избегаем раздувания инфраструктуры (у нас уже есть PostgreSQL и RabbitMQ), ставить отдельную векторную БД вроде Milvus или Qdrant — это оверинжиниринг. Идеальный prod-ready паттерн — использовать расширение "},{"type":"text","marks":[{"type":"bold"},{"type":"code"}],"text":"pgvector"},{"type":"text","text":" прямо внутри твоего PostgreSQL. Это позволит хранить векторы в соседней таблице с фактами и делать JOIN-ы (например, искать эмбеддинг только среди фактов за последний месяц)."}]}]}]}]}},"parentId":"page:0B5M8jwvXbPmG5LVHH5kx","index":"aLG6I","typeName":"shape"},{"meta":{},"id":"binding:mxnZpK8f0ry6DOHidiiF2","type":"arrow","fromId":"shape:HeUCHMC77BeDfw5hKLbC0","toId":"shape:7gR6TQwPYCEoZBknmCLfM","props":{"isPrecise":true,"isExact":false,"normalizedAnchor":{"x":0.476481016123387,"y":0.5157878447119124},"snap":"none","terminal":"end"},"typeName":"binding"},{"x":1777.1074415892983,"y":489.81170272391455,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:RHUWzw5b68yJa7THhqJJq","type":"text","props":{"color":"black","size":"m","w":263.2749938964844,"font":"draw","textAlign":"start","autoSize":true,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"heading","attrs":{"dir":"auto","level":1},"content":[{"type":"text","text":"Стек"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Python: 3.13"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"default logs "}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Alembic"}]}]},{"type":"l