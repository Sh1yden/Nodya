izedAnchor":{"x":0.5247127769718003,"y":0.33121170450449},"snap":"none","terminal":"start"},"typeName":"binding"},{"x":-5339.836639674666,"y":877.8859002034594,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:rKXnH4FkX3QSR2-fuwC8D","type":"arrow","props":{"kind":"arc","elbowMidPoint":0.5,"dash":"draw","size":"m","fill":"none","color":"black","labelColor":"black","bend":0,"start":{"x":0,"y":0},"end":{"x":2,"y":0},"arrowheadStart":"none","arrowheadEnd":"arrow","richText":{"type":"doc","content":[{"type":"paragraph"}]},"labelPosition":0.5,"font":"draw","scale":1},"parentId":"page:page","index":"b1YoXr","typeName":"shape"},{"x":15.259334481538644,"y":150.3841937981631,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:2-yMW1s7mWJIHGAxgDoC4","type":"text","props":{"color":"black","size":"m","w":140.71250915527344,"font":"draw","textAlign":"start","autoSize":true,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"created_at"}]}]}},"parentId":"shape:1Z-KkEPfheDkmZHifo1oS","index":"a8S02","typeName":"shape"},{"meta":{},"id":"binding:nDjvcbBxOv6OcEMS7UvmG","type":"arrow","fromId":"shape:Q4r77nQGXcDXnT_lWW_Fy","toId":"shape:puaBh_yJwIMrJjPqkNq9d","props":{"isPrecise":false,"isExact":false,"normalizedAnchor":{"x":0.5,"y":0.5},"snap":"center","terminal":"start"},"typeName":"binding"},{"x":-3847.9997786466224,"y":584.2717450388723,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:GAsJt3QXZ2D8qi9Q3IrGU","type":"text","props":{"color":"black","size":"m","w":2827,"font":"draw","textAlign":"start","autoSize":true,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"heading","attrs":{"dir":"auto","level":1},"content":[{"type":"text","text":"Жизненный цикл ИИ-агента (Application Lifecycle)"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Поскольку Нодя — это не просто API, отвечающее на запросы, а автономный агент, её жизненный цикл похож на работу демона в Linux. Он состоит из пяти строгих фаз."}]},{"type":"heading","attrs":{"dir":"auto","level":3},"content":[{"type":"text","text":"Фаза 1: Bootstrap (Инициализация)"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"italic"}],"text":"Происходит при запуске docker-compose."}]},{"type":"orderedList","attrs":{"dir":"auto","start":1,"type":null},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"FastAPI стартует."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Выполняются миграции Alembic (если есть новые таблицы)."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Проверяются пулы соединений (Healthchecks): пингуется PostgreSQL, Redis, RabbitMQ и Qdrant. Если хоть кто-то лежит — приложение падает с ошибкой (Fail Fast)."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Собирается и регистрируется \"Реестр Навыков\" (Tools). Система проверяет, есть ли у неё права на выполнение локальных скриптов."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Открывается постоянное соединение (Consumer) с RabbitMQ."}]}]}]},{"type":"heading","attrs":{"dir":"auto","level":3},"content":[{"type":"text","text":"Фаза 2: Active Loop (Активный диалог)"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"italic"}],"text":"Происходит, когда в RabbitMQ прилетает сообщение от тебя."}]},{"type":"orderedList","attrs":{"dir":"auto","start":1,"type":null},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Consumer берет задачу."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Ставит Lock в Redis (чтобы другие сообщения пока ждали)."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Меняет стейт в Redis на "},{"type":"text","marks":[{"type":"code"}],"text":"thinking"},{"type":"text","text":"."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Сборка контекста:"},{"type":"text","text":" Бэкенд делает поиск по Qdrant (вытаскивает похожие старые разговоры), делает SELECT из Postgres (вытаскивает жесткие факты) и достает из Redis последние 10-20 сообщений текущего диалога."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Весь этот массив склеивается в динамический System Prompt и улетает в "},{"type":"text","marks":[{"type":"code"}],"text":"Gemini 3.5 Flash Lite"},{"type":"text","text":"."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Если модель решила вызвать Tool — выполняется локальная функция, результат возвращается модели."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Генерируется финальный ответ, кладется в очередь на отправку в Telegram, снимается Lock, стейт возвращается в "},{"type":"text","marks":[{"type":"code"}],"text":"idle"},{"type":"text","text":"."}]}]}]},{"type":"heading","attrs":{"dir":"auto","level":3},"content":[{"type":"text","text":"Фаза 3: Skills(Фоновое восприятие)"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"italic"}],"text":"Срабатывает по крону (например, через APScheduler раз в 30 минут)."}]},{"type":"orderedList","attrs":{"dir":"auto","start":1,"type":null},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Фоновая задача парсит внешние источники (RSS, Telegram-каналы)."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Отдает сырой текст в "},{"type":"text","marks":[{"type":"code"}],"text":"Gemma 4"},{"type":"text","text":" с промптом-фильтром: "},{"type":"text","marks":[{"type":"italic"}],"text":"\"Оцени от 0 до 10, насколько это интересно пользователю, учитывая его профиль\""},{"type":"text","text":"."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Если оценка высокая (например, >8), воркер формирует сообщение Ноди и кидает его в очередь RabbitMQ на отправку тебе (инициирует диалог)."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Если оценка средняя — просто сохраняет выжимку в Qdrant как фоновое знание."}]}]}]},{"type":"heading","attrs":{"dir":"auto","level":3},"content":[{"type":"text","text":"Фаза 4: Consolidation (Сон и компрессия памяти)"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"italic"}],"text":"Срабатывает раз в сутки (ночью) ИЛИ если "},{"type":"text","marks":[{"type":"code"},{"type":"italic"}],"text":"last_active_at"},{"type":"text","marks":[{"type":"italic"}],"text":" в Redis был больше 3 часов назад."}]},{"type":"orderedList","attrs":{"dir":"auto","start":1,"type":null},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Воркер смотрит в "},{"type":"text","marks":[{"type":"code"}],"text":"nodya:context:{user_id}"},{"type":"text","text":" в Redis."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Если там накопились сообщения, он забирает их все."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Отправляет их в тяжелую, но медленную модель "},{"type":"text","marks":[{"type":"code"}],"text":"Gemini 3.6 Flash"},{"type":"text","text":" с задачей: "},{"type":"text","marks":[{"type":"italic"}],"text":"\"Извлеки жесткие факты для JSON-структуры и выдели семантические блоки для векторизации\""},{"type":"text","text":"."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Обновляет/добавляет записи в PostgreSQL и новые векторы в Qdrant."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Полностью очищает список диалога в Redis. Нодя \"просыпается\" с чистой оперативкой, но обогащенной долговременной памятью."}]}]}]},{"type":"heading","attrs":{"dir":"auto","level":3},"content":[{"type":"text","text":"Фаза 5: Graceful Shutdown (Мягкая остановка)"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"italic"}],"text":"Срабатывает при получении сигнала "},{"type":"text","marks":[{"type":"code"},{"type":"italic"}],"text":"SIGTERM"},{"type":"text","marks":[{"type":"italic"}],"text":" (например, ты написал "},{"type":"text","marks":[{"type":"code"},{"type":"italic"}],"text":"docker compose down"},{"type":"text","marks":[{"type":"italic"}],"text":" или обновил код)."}]},{"type":"orderedList","attrs":{"dir":"auto","start":1,"type":null},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"API перестает принимать новые HTTP-запросы."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Consumer в RabbitMQ отписывается от очереди (новые сообщения копятся на диске)."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Система дожидается (с таймаутом, например, 30 секунд), пока завершатся текущие запросы к Google AI Studio и сохранятся данные в БД."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Закрываются пулы соединений (DB, Redis)."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Процесс корректно завершается, не теряя ни одного байта данных."}]}]}]}]}},"parentId":"page:page","index":"b0TzUzG","typeName":"shape"},{"x":-4996.9253215768995,"y":2382.450839538987,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:Z9fTNxCGU4RKtIgkrpZGn","type":"text","props":{"color":"black","size":"m","w":428.9250183105469,"font":"draw","textAlign":"start","autoSize":true,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Приходит сообщение от Telegram"}]}]}},"parentId":"page:page","index":"b1w1xE","typeName":"shape"},{"x":298.44301048670224,"y":691.1303024215748,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:zJbjb3Pr2QvkjbIjxD7I-","type":"arrow","props":{"kind":"arc","elbowMidPoint":0.5,"dash":"draw","size":"m","fill":"none","color":"black","labelColor":"black","bend":0,"start":{"x":0,"y":0},"end":{"x":185.42328824641498,"y":57.27359917292449},"arrowheadStart":"none","arrowheadEnd":"arrow","richText":{"type":"doc","content":[{"type":"paragraph"}]},"labelPosition":0.5,"font":"draw","scale":1},"parentId":"page:page","